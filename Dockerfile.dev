
FROM mcr.microsoft.com/dotnet/sdk:10.0

# Install FFmpeg, which HiveMind uses
COPY --from=mwader/static-ffmpeg:6.1 /ffmpeg /usr/local/bin/ffmpeg
COPY --from=mwader/static-ffmpeg:6.1 /ffprobe /usr/local/bin/ffprobe

# Install tools needed for remote C# debugging
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN curl -sSL https://aka.ms/getvsdbgsh \
    | bash /dev/stdin -v latest -l /vsdbg

WORKDIR /workspace

EXPOSE 5280

CMD ["dotnet", "watch", "run", "--project", "HiveMind.Server/HiveMind.Server.csproj", "--no-launch-profile", "--urls", "http://0.0.0.0:5280"]
